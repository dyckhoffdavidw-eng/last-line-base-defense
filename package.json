{
  "name": "last-line-base-defense",
  "version": "1.2.0",
  "description": "A standalone base-defense game with gun and base skill trees.",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --x64"
  },
  "build": {
    "appId": "com.lastline.basedefense",
    "productName": "Last Line",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "styles.css",
      "game.js",
      "main.cjs",
      "icon.png"
    ],
    "win": {
      "target": "portable",
      "icon": "icon.png"
    },
    "portable": {
      "artifactName": "Last-Line-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  }
}
